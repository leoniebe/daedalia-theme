<?xml version="1.0"?>
<ruleset name="Daedalia-thema">
	<description>WordPress Coding Standards for the Daedalia theme.</description>

	<!-- The theme's own code; daedalia/ is the bundled plugin, checked in its own repository, and tests/
	     holds what the analysis needs (the Daedalia API stub), not theme code. -->
	<file>.</file>
	<exclude-pattern>/daedalia/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="basepath" value="."/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- `$a ?: $b` is ordinary PHP and used on purpose for "this, else that". -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>

	<!-- Hooks are named daedalia_thema/name, as Daedalia's daedalia/part/name. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="daedalia-thema"/>
			</property>
		</properties>
	</rule>

	<!-- daedalia_thema_* for the theme's own names; DAEDALIA_BUNDLED tells the bundled plugin it is bundled. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="daedalia_thema"/>
				<element value="DAEDALIA_BUNDLED"/>
			</property>
		</properties>
	</rule>
</ruleset>
