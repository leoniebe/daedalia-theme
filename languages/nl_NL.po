#. Theme Name of the theme
#: style.css:2
msgid "Daedalia"
msgstr "Daedalia"

#. Theme URI of the theme
#. Author URI of the theme
#: style.css:3
#: style.css:9
msgid "https://langemaire-websolutions.nl"
msgstr "https://langemaire-websolutions.nl"

#. Description of the theme
#: style.css:4
msgid "A lightweight theme for the Daedalia page builder. The theme itself does almost nothing: header, footer, pages, product pages and archives come from Daedalia, and colors, fonts and layout from Daedalia’s site settings. Daedalia can be bundled with the theme or run as a plugin."
msgstr "Een licht thema voor de Daedalia-pagebuilder. Het thema zelf doet bijna niets: header, footer, pagina’s, productpagina’s en archieven komen uit Daedalia, en kleuren, lettertypen en formaat uit de site-instellingen van Daedalia. Daedalia kan in het thema meegeleverd worden of als plugin draaien."

#. Author of the theme
#: style.css:8
msgid "Langemaire Websolutions"
msgstr "Langemaire Websolutions"

#: 404.php:13
msgid "This page doesn’t exist (anymore)"
msgstr "Deze pagina bestaat niet (meer)"

#: 404.php:14
msgid "Search for what you need, or go back to the homepage."
msgstr "Zoek wat je nodig hebt, of ga terug naar de homepage."

#: 404.php:16
msgid "Go to the homepage"
msgstr "Naar de homepage"

#. translators: %s: number of comments.
#: comments.php:21
#, php-format
msgid "%s comment"
msgid_plural "%s comments"
msgstr[0] "%s reactie"
msgstr[1] "%s reacties"

#: comments.php:39
msgid "Comments"
msgstr "Reacties"

#: comments.php:46
msgid "Comments are closed."
msgstr "Reageren is gesloten."

#: footer.php:13
#: functions.php:62
msgid "Footer menu"
msgstr "Menu in de footer"

#: functions.php:61
#: header.php:42
msgid "Main menu"
msgstr "Hoofdmenu"

#: functions.php:91
msgid "The Daedalia theme works with the Daedalia page builder. Put the daedalia/ folder in the theme (npm run bundel) or activate the Daedalia plugin."
msgstr "Het Daedalia-thema werkt samen met de Daedalia-pagebuilder. Zet de map daedalia/ in het thema (npm run bundel) of activeer de plugin Daedalia."

#. translators: 1: running Daedalia version, 2: minimum version, 3: version bundled in the theme
#: functions.php:110
#, php-format
msgid "The Daedalia plugin %1$s is too old for this theme (%2$s or newer). Update the plugin, or deactivate it: then Daedalia %3$s runs from the theme."
msgstr "De plugin Daedalia %1$s is te oud voor dit thema (%2$s of nieuwer). Werk de plugin bij, of zet hem uit: dan draait Daedalia %3$s uit het thema."

#. translators: 1: running Daedalia version, 2: minimum version
#: functions.php:112
#, php-format
msgid "The Daedalia plugin %1$s is too old for this theme (%2$s or newer). Update the plugin."
msgstr "De plugin Daedalia %1$s is te oud voor dit thema (%2$s of nieuwer). Werk de plugin bij."

#. translators: 1: plugin version, 2: version bundled in the theme
#: functions.php:116
#, php-format
msgid "The Daedalia plugin %1$s is older than Daedalia %2$s in the theme, and an active plugin comes first. Update or deactivate the plugin."
msgstr "De plugin Daedalia %1$s is ouder dan Daedalia %2$s in het thema, en een actieve plugin gaat voor. Werk de plugin bij of zet hem uit."

#: header.php:20
msgid "Skip to content"
msgstr "Naar de inhoud"

#: inc/beveiliging.php:96
msgid "Login failed. Check your username or email address and your password."
msgstr "Inloggen is niet gelukt. Controleer je gebruikersnaam of e-mailadres en je wachtwoord."

#: inc/beveiliging.php:221
msgid "Too many failed attempts. Try again in 15 minutes."
msgstr "Te veel mislukte pogingen. Probeer het over 15 minuten opnieuw."

#: inc/instellingen.php:26
msgid "Remove the emoji script"
msgstr "Emoji-script weg"

#: inc/instellingen.php:26
msgid "Browsers show emoji themselves; WordPress’s script and style aren’t needed."
msgstr "Browsers tonen emoji zelf; het script en de stijl van WordPress zijn niet nodig."

#: inc/instellingen.php:27
msgid "Remove wp-embed"
msgstr "wp-embed weg"

#: inc/instellingen.php:27
msgid "The script for embedding this site in other sites."
msgstr "Het script om deze site in andere sites in te sluiten."

#: inc/instellingen.php:28
msgid "Block styles only where there are blocks"
msgstr "Blokstijlen alleen waar blokken staan"

#: inc/instellingen.php:28
msgid "The block editor’s styles load only on pages with blocks, and on cart, checkout and my account."
msgstr "De stijlen van de blokeditor laden alleen op pagina’s met blokken, en bij winkelwagen, afrekenen en mijn account."

#: inc/instellingen.php:29
msgid "Remove unneeded lines from the head"
msgstr "Overbodige regels in de head weg"

#: inc/instellingen.php:29
msgid "RSD, Windows Live Writer and the shortlink."
msgstr "RSD, Windows Live Writer en de korte link."

#: inc/instellingen.php:30
msgid "No WordPress version in the HTML"
msgstr "Geen WordPress-versie in de HTML"

#: inc/instellingen.php:30
msgid "The generator tag and the version number after WordPress’s own scripts and styles."
msgstr "De generator-tag en het versienummer achter scripts en stijlen van WordPress zelf."

#: inc/instellingen.php:31
msgid "No Dashicons for visitors"
msgstr "Geen dashicons voor bezoekers"

#: inc/instellingen.php:31
msgid "The admin icon font loads only for logged-in users (the admin bar)."
msgstr "Het iconenlettertype van het beheer laadt alleen voor wie is ingelogd (de beheerbalk)."

#: inc/instellingen.php:32
msgid "WooCommerce CSS only on shop pages"
msgstr "WooCommerce-CSS alleen op winkelpagina’s"

#: inc/instellingen.php:32
msgid "WooCommerce’s styles don’t load on pages without the shop. Turn this off if a WooCommerce shortcode is on a regular page. Daedalia handles WooCommerce’s scripts (Daedalia › Settings › WooCommerce)."
msgstr "De stijlen van WooCommerce laden niet op pagina’s zonder winkel. Zet het uit als een WooCommerce-shortcode op een gewone pagina staat. De scripts van WooCommerce regelt Daedalia (Daedalia › Instellingen › WooCommerce)."

#: inc/instellingen.php:33
msgid "Remove jQuery Migrate"
msgstr "jQuery Migrate weg"

#: inc/instellingen.php:33
msgid "Only old plugins need this. Turn it on and check that everything still works."
msgstr "Alleen oude plugins hebben dit nodig. Zet het aan en kijk of alles nog werkt."

#: inc/instellingen.php:35
msgid "Turn off XML-RPC"
msgstr "XML-RPC uit"

#: inc/instellingen.php:35
msgid "An old way in for apps that is often used for login attacks. Turn this off if you need the Jetpack app or an old publishing app."
msgstr "Een oude toegang voor apps die vaak voor inlogaanvallen wordt gebruikt. Zet het aan als je de Jetpack-app of een oude publicatie-app nodig hebt."

#: inc/instellingen.php:36
msgid "User list closed to guests"
msgstr "Gebruikerslijst dicht voor gasten"

#: inc/instellingen.php:36
msgid "The REST route with the users (and so the usernames) is only for those allowed to see users."
msgstr "De REST-route met de gebruikers (en dus de gebruikersnamen) is alleen voor wie gebruikers mag zien."

#: inc/instellingen.php:37
msgid "Authors can’t be guessed"
msgstr "Auteurs niet te raden"

#: inc/instellingen.php:37
msgid "An address like ?author=1 no longer gives away a username."
msgstr "Een adres als ?author=1 verraadt geen gebruikersnaam meer."

#: inc/instellingen.php:38
msgid "Login errors give nothing away"
msgstr "Inlogfouten verraden niets"

#: inc/instellingen.php:38
msgid "One message for a wrong name and a wrong password."
msgstr "Eén melding voor een verkeerde naam en een verkeerd wachtwoord."

#: inc/instellingen.php:39
msgid "Limit login attempts"
msgstr "Inlogpogingen beperken"

#: inc/instellingen.php:39
msgid "After 5 failed attempts with the same name, or 20 from the same address, wait 15 minutes."
msgstr "Na 5 mislukte pogingen met dezelfde naam, of 20 vanaf hetzelfde adres, 15 minuten wachten."

#: inc/instellingen.php:40
msgid "Turn off the file editor"
msgstr "Bestandsbewerker uit"

#: inc/instellingen.php:40
msgid "Theme and plugin files can’t be edited in the admin."
msgstr "Thema- en pluginbestanden zijn niet in het beheer te bewerken."

#: inc/instellingen.php:42
msgid "X-Content-Type-Options"
msgstr "X-Content-Type-Options"

#: inc/instellingen.php:42
msgid "The browser doesn’t guess the file type itself."
msgstr "De browser raadt het soort bestand niet zelf."

#: inc/instellingen.php:43
msgid "Referrer-Policy"
msgstr "Referrer-Policy"

#: inc/instellingen.php:43
msgid "Other sites see only the domain a visitor comes from, not the whole link."
msgstr "Andere sites zien alleen het domein waar een bezoeker vandaan komt, niet de hele link."

#: inc/instellingen.php:44
msgid "X-Frame-Options (this site only)"
msgstr "X-Frame-Options (alleen deze site)"

#: inc/instellingen.php:44
msgid "Other sites can’t show this site in a frame (against clickjacking). Daedalia’s editor keeps working."
msgstr "Andere sites kunnen deze site niet in een frame tonen (tegen clickjacking). De editor van Daedalia blijft werken."

#: inc/instellingen.php:45
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: inc/instellingen.php:45
msgid "Camera, microphone and location are off for the page and embedded content. Payments still work."
msgstr "Camera, microfoon en locatie staan uit voor de pagina en ingesloten inhoud. Betalen blijft mogelijk."

#: inc/instellingen.php:46
msgid "Content-Security-Policy, report only"
msgstr "Content-Security-Policy, alleen melden"

#: inc/instellingen.php:46
msgid "A CSP in report mode: the browser reports in the console what a strict CSP would block, but blocks nothing."
msgstr "Een CSP in meldmodus: de browser meldt in de console wat een strenge CSP zou tegenhouden, maar blokkeert niets."

#: inc/instellingen.php:47
msgid "Strict-Transport-Security (HSTS)"
msgstr "Strict-Transport-Security (HSTS)"

#: inc/instellingen.php:47
msgid "Only on https. Browsers remember for a year that the site is https only; going back to http is then no longer possible."
msgstr "Alleen op https. Browsers onthouden een jaar dat de site alleen via https mag; terug naar http kan dan niet meer."

#: inc/instellingen.php:67
#: inc/instellingen.php:102
msgid "Daedalia theme"
msgstr "Daedalia-thema"

#: inc/instellingen.php:96
msgid "Slimming down: load less"
msgstr "Afslanken: minder laden"

#: inc/instellingen.php:97
msgid "Security"
msgstr "Beveiliging"

#: inc/instellingen.php:98
msgid "Security headers"
msgstr "Beveiligingsheaders"

#: inc/instellingen.php:104
msgid "Settings saved."
msgstr "Instellingen opgeslagen."

#: inc/instellingen.php:106
msgid "What the theme turns off, turns on or sends along. Each part stands alone: if something on your site stops working, turn off only that part. Parts that can break something are off by default."
msgstr "Wat het thema uitzet, aanzet of meestuurt. Elk onderdeel staat los: werkt iets op je site niet meer, zet dan alleen dat onderdeel uit. Onderdelen die iets kunnen breken, staan standaard uit."

#: inc/instellingen.php:120
msgid "(off by default)"
msgstr "(standaard uit)"

#: inc/instellingen.php:126
msgid "Save"
msgstr "Opslaan"

#: parts/lijst.php:29
msgid "Nothing found (yet)."
msgstr "Er is (nog) niets gevonden."

#. translators: %s: search terms
#: search.php:14
#, php-format
msgid "Search results for “%s”"
msgstr "Zoekresultaten voor “%s”"
